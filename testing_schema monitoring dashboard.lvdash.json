{
  "datasets": [
    {
      "name": "schema_registry",
      "displayName": "Schema Registry",
      "queryLines": [
        "SELECT\n",
        "  *,\n",
        "  SIZE(FROM_JSON(schema_json, 'MAP<STRING, STRING>')) AS num_columns\n",
        "FROM\n",
        "  observability.schema_registry"
      ],
      "columns": [
        {
          "displayName": "full_table_name",
          "description": "Fully qualified table name",
          "expression": "CONCAT(`catalog_name`, '.', `schema_name`, '.', `table_name`)"
        },
        {
          "displayName": "full_schema_name",
          "description": "Fully qualified schema name",
          "expression": "CONCAT(`catalog_name`, '.', `schema_name`)"
        }
      ],
      "catalog": "dev_dlh_platform",
      "schema": "default"
    },
    {
      "name": "downstream_lineage",
      "displayName": "Downstream Lineage",
      "queryLines": [
        "SELECT\n",
        "  source_table_catalog,\n",
        "  source_table_schema,\n",
        "  source_table_name,\n",
        "  asset_type,\n",
        "  asset_name,\n",
        "  asset_id,\n",
        "  last_seen\n",
        "FROM\n",
        "  (\n",
        "    SELECT\n",
        "      l.source_table_catalog,\n",
        "      l.source_table_schema,\n",
        "      l.source_table_name,\n",
        "      l.target_type AS asset_type,\n",
        "      l.target_table_full_name AS asset_name,\n",
        "      CAST(NULL AS STRING) AS asset_id,\n",
        "      MAX(l.event_time) AS last_seen\n",
        "    FROM\n",
        "      system.access.table_lineage l\n",
        "        INNER JOIN (\n",
        "          SELECT DISTINCT\n",
        "            catalog_name,\n",
        "            schema_name,\n",
        "            table_name\n",
        "          FROM\n",
        "            observability.schema_registry\n",
        "          WHERE\n",
        "            status = 'Active'\n",
        "        ) r\n",
        "          ON l.source_table_catalog = r.catalog_name\n",
        "          AND l.source_table_schema = r.schema_name\n",
        "          AND l.source_table_name = r.table_name\n",
        "    WHERE\n",
        "      l.target_table_full_name IS NOT NULL\n",
        "    GROUP BY\n",
        "      l.source_table_catalog,\n",
        "      l.source_table_schema,\n",
        "      l.source_table_name,\n",
        "      l.target_type,\n",
        "      l.target_table_full_name\n",
        "    UNION ALL\n",
        "    SELECT\n",
        "      l.source_table_catalog,\n",
        "      l.source_table_schema,\n",
        "      l.source_table_name,\n",
        "      l.entity_type AS asset_type,\n",
        "      l.entity_id AS asset_name,\n",
        "      l.entity_id AS asset_id,\n",
        "      MAX(l.event_time) AS last_seen\n",
        "    FROM\n",
        "      system.access.table_lineage l\n",
        "        INNER JOIN (\n",
        "          SELECT DISTINCT\n",
        "            catalog_name,\n",
        "            schema_name,\n",
        "            table_name\n",
        "          FROM\n",
        "            observability.schema_registry\n",
        "          WHERE\n",
        "            status = 'Active'\n",
        "        ) r\n",
        "          ON l.source_table_catalog = r.catalog_name\n",
        "          AND l.source_table_schema = r.schema_name\n",
        "          AND l.source_table_name = r.table_name\n",
        "    WHERE\n",
        "      l.entity_type IS NOT NULL\n",
        "      AND l.entity_id IS NOT NULL\n",
        "    GROUP BY\n",
        "      l.source_table_catalog,\n",
        "      l.source_table_schema,\n",
        "      l.source_table_name,\n",
        "      l.entity_type,\n",
        "      l.entity_id\n",
        "  )"
      ],
      "columns": [
        {
          "displayName": "source_full_name",
          "description": "Fully qualified source table name",
          "expression": "CONCAT(`source_table_catalog`, '.', `source_table_schema`, '.', `source_table_name`)"
        }
      ],
      "catalog": "dev_dlh_platform",
      "schema": "default"
    }
  ],
